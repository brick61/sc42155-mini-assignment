def run_3(q,x,data,t_end,name):

    #setting time to 0
    t_now = 0.0

    #lists to store the simulation
    t_list = []
    x_list = []
    q_list = []
    saved = []


    #main loop of the hybrid simulation
    while t_now < t_end:

        #simulate until an event fires or t_end is reached
        sol = solve_ivp(lambda tt, xx: sys(xx, inputs(q, tt, xx, data)),
                        (t_now, t_end), x, method='Radau', events=events[q],
                        max_step=0.05, rtol=1e-8, atol=1e-10)

        #store the result
        t_list.append(sol.t)
        x_list.append(sol.y)
        q_list.append(np.full(sol.t.size, q))

        #stop if t_end is reached (no event fired)
        if sol.status != 1:
            break

        #state at the moment the event fired
        t_now = sol.t[-1]
        x = sol.y[:, -1].copy()

        #switch log, before the resets so s at the F event is visible
        px_s, py_s = path_from_state(x)[0:2]


        #reset maps
        x[10] = 0                                  #tau resets on every transition
        if q == 0:
            data['phi_s'] = t_now - data['t_off']      #save spot where printing stopped
            saved.append((px_s*1e3, py_s*1e3))
            t_C = 1e9                              #colour change only happens once
        if q == 5:
            x[9] = 0                               #s resets, new spool loaded
        if q == 7:
            data['t_off'] = t_now - data['phi_s']      #resume ellipse at saved spot

        #go to the next mode and build its input data
        q = next_q[q]
        data = enter_mode(q, t_now, x, data)

        #event log
        print(f't = {t_now:.2f} s, now in mode q{q}')

    #Q3.1 plot
    tt = np.concatenate(t_list)   # time of all segments
    XX = np.hstack(x_list)        # states of all segments
    QQ = np.concatenate(q_list)   # mode at every time sample
    pr = (QQ == 0) | (QQ >= 8) #false for q1 to 7, true for q8 to 11 and 0

    px = 0.5*r*(XX[0] + XX[1])*1e3   
    py = 0.5*r*(XX[0] - XX[1])*1e3   

    fig, ax = plt.subplot_mosaic([['xy', 'q'],
                                ['xy', 'T'],
                                ['xy', 's']], figsize=(10, 5))

    # left plot: path, printing vs moving
    ax['xy'].plot(np.where(pr, px, np.nan), np.where(pr, py, np.nan), label='printing ($e = 1$)')
    ax['xy'].plot(np.where(~pr, px, np.nan), np.where(~pr, py, np.nan), label='moving ($q_1, q_2, q_7$)')
    ax['xy'].plot(0, 0, 'ks', label='wipe tower')
    if saved:
        sx, sy = np.array(saved).T
        ax['xy'].plot(sx, sy, 'ro', ms=5, label='saved points $(x_s, y_s)$')
    ax['xy'].set(xlabel='x [mm]', ylabel='y [mm]', aspect='equal')
    ax['xy'].legend(loc='upper center', bbox_to_anchor=(0.5, -0.15), ncol=2, fontsize=8)

    # right: mode, nozzle temperature, printed path length
    ax['q'].plot(tt, QQ, drawstyle='steps-post')
    ax['q'].set(ylabel='mode $q$', yticks=range(12))

    ax['T'].plot(tt, XX[6])
    ax['T'].axhline(T_H, color='k', ls='--', lw=0.8)
    ax['T'].axhline(T_L, color='k', ls='--', lw=0.8)
    ax['T'].set(ylabel='$T_n$ [°C]')

    ax['s'].plot(tt, XX[9])
    ax['s'].axhline(s_spool, color='k', ls='--', lw=0.8)
    ax['s'].set(ylabel='$s$ [m]', xlabel='t [s]')

    for k in ['T', 's']:
        ax[k].sharex(ax['q'])
    for k in ['q', 'T']:
        ax[k].tick_params(labelbottom=False)

    fig.tight_layout()
    fig.savefig(f'q31_hybrid_{name}.pdf', bbox_inches='tight')
    plt.show()
    return


