    ax2.set(xlabel='t [s]', ylabel='voltage [V]')
    ax2.set_box_aspect(1)
    ax2.legend()


    fig.tight_layout()
    fig.savefig(f'q14_{name}.pdf', bbox_inches='tight')
    plt.show()


