#sys function
def sys(x,u):
    dx = np.zeros(11)
    #fill the first rows with the Q1.2 equations
    dx[0:6] = A @ x[0:6] + B @ u[0:2] 

    #equation 55 of overleaf
    T_n = x[6]
    i_L = x[7]
    u_c = x[8]
    u_n = u[2]

    dx[6] = (1 / C_t_n) * (u_c**2 / R_n - (T_n - T_e) / R_t_n)
    dx[7] = (u_n - u_c) / L_n
    dx[8] = i_L / C_n - u_c / (R_n * C_n)

    #printed path length s
    dth_l = x[2]
    dth_r = x[3]
    e = u[3]
 
    dx[9] = e * r / np.sqrt(2) * np.sqrt(dth_l**2 + dth_r**2)
 
    #mode timer tau
    dx[10] = 1
 
    return dx

#finding u_l and u_r, I already did it in question 1.4 but now need it seperate 
def feedforward(dx, ddx, dddx, dy, ddy, dddy):
    #define ux and uy
    u_x = L_m * c_1 * dddx + R_m * c_1 * ddx + (2*K_m)/r * dx
    u_y = L_m * c_1 * dddy + R_m * c_1 * ddy + (2*K_m)/r * dy

    #relate it back to u_l and u_r abd make it a function
    u_l = 0.5*(u_x + u_y)
    u_r = 0.5*(u_x - u_y)

    return u_l, u_r

#use the ellipse again as reference for 3.1
x_ell = x_c + a_ell*sp.cos(w_ell*t)
y_ell = y_c + b_ell*sp.sin(w_ell**t)

#position and first three derivatives, written in matrix
ref_x = sp.lambdify(t, [sp.diff(x_ell, t, k) for k in range(4)], 'numpy')
ref_y = sp.lambdify(t, [sp.diff(y_ell, t, k) for k in range(4)], 'numpy')

#function only evaluates so it goes fast
def ellipse_ref(t_ref):
    return ref_x(t_ref), ref_y(t_ref)

#polynomial so that position, velocity and accelration match at the start and end
def quintic(p0, v0, a0, pf, vf, af, T):
    #known coefficietns from start conditions
    c0 = p0
    c1 = v0
    c2 = a0/2

    #3x3 system for c3,c4,c5
    M = np.array([[T**3,    T**4,     T**5],
                  [3*T**2,  4*T**3,   5*T**4],
                  [6*T,     12*T**2,  20*T**3]])
    
    rhs = np.array([pf - c0 - c1*T - c2*T**2,
                    vf - c1 - 2*c2*T,
                    af - 2*c2])
    
    c3, c4, c5 = np.linalg.solve(M, rhs)
    return Polynomial([c0, c1, c2, c3, c4, c5])
    
#To convert the motor coordinates to cartesian
def path_from_state(x):
    th_l, th_r, dth_l, dth_r, i_l, i_r = x[0:6]
    px = 0.5*r*(th_l + th_r)    
    py = 0.5*r*(th_l - th_r)     
    vx = 0.5*r*(dth_l + dth_r)  
    vy = 0.5*r*(dth_l - dth_r)   
    ax = c_3*(i_l + i_r)         
    ay = c_3*(i_l - i_r)         
    return px, py, vx, vy, ax, ay

#to supply u every time the solver needs it
def inputs(q, tq, x, data):
    if q == 0:   #printing
        X, Y = ellipse_ref(tq - data['t_off'])
        u_l, u_r = feedforward(X[1], X[2], X[3], Y[1], Y[2], Y[3])
        return [u_l, u_r, u_hold, 1]


    if q == 1 or q == 2 or q == 7:  #moves
        sigma = tq - data['t_entry']
        cx = data['cx']
        cy = data['cy']
        u_l, u_r = feedforward(cx.deriv(1)(sigma), cx.deriv(2)(sigma), cx.deriv(3)(sigma),
                               cy.deriv(1)(sigma), cy.deriv(2)(sigma), cy.deriv(3)(sigma))
        return [u_l, u_r, u_hold, 0]

    if q == 3:   #wiping --> motors off, hold temperature
        return [0, 0, u_hold, 0]
    if q in (4, 5):   #cooling and loading --> everything off
        return [0, 0, 0, 0]
    if q == 6:   #heating --> full heater voltage
        return [0, 0, U_max, 0]
    if q == 8 or q == 9 or q == 10 or q == 11:    #input while drawing square
        dx, ddx, dddx = derivs(data['cx'], tq - data['tx'])
        dy, ddy, dddy = derivs(data['cy'], tq - data['ty'])
        u_l, u_r = feedforward(dx, ddx, dddx, dy, ddy, dddy)
        return [u_l, u_r, u_hold, 1]  


def enter_mode(q, tq, x, data):

    data = dict(data) #copy so the old mode keeps its own data
    data['t_entry'] = tq

    #only the moves need a quintic
    if q == 1 or q == 2 or q == 7:

        px, py, vx, vy, ax, ay = path_from_state(x) #start from where the head is now

        if q == 1: #stop after the stopping distance
            T = T_stop
            end_x = [px + 0.5*vx*T_stop, 0, 0]
            end_y = [py + 0.5*vy*T_stop, 0, 0]
        if q == 2: #go to the wipe tower at (0,0)
            T = T_tr
            end_x = [0, 0, 0]
            end_y = [0, 0, 0]
        if q == 7: #go back to the saved point on the ellipse
            T = T_tr
            X, Y = ellipse_ref(data['phi_s'])
            end_x = X[0:3]
            end_y = Y[0:3]

        data['cx'] = quintic(px, vx, ax, end_x[0], end_x[1], end_x[2], T)
        data['cy'] = quintic(py, vy, ay, end_y[0], end_y[1], end_y[2], T)

    if q == 8 or q == 9 or q == 10 or q == 11: #for the square
        k = q - 8

        px, py, vx, vy = path_from_state(x)[0:4]    #position and velocity from the angle sensors
        ex, ey = corners[(k+1) % 4]                 #next corner

        if k % 2 == 0:   #sides 0 and 2 move along x
            data['cx'] = quintic(px, vx, 0, ex, 0, 0, T_side)
            data['tx'] = tq
        else:            #sides 1 and 3 move along y
            data['cy'] = quintic(py, vy, 0, ey, 0, 0, T_side)
            data['ty'] = tq
    
    return data

